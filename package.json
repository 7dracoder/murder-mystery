{
  "name": "murder-mystery",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "orchestrator": "CHARACTER=orchestrator npx tsx src/agent.ts",
    "butler": "CHARACTER=butler npx tsx src/agent.ts",
    "widow": "CHARACTER=widow npx tsx src/agent.ts",
    "scientist": "CHARACTER=scientist npx tsx src/agent.ts",
    "banker": "CHARACTER=banker npx tsx src/agent.ts",
    "detective": "CHARACTER=detective npx tsx src/agent.ts",
    "server": "npx tsx server.ts",
    "web": "cd web && npx vite",
    "start:web": "concurrently \"npm run server\" \"npm run web\""
  },
  "dependencies": {
    "@honcho-ai/core": "^2.2.0",
    "@honcho-ai/sdk": "^2.0.1",
    "@xmtp/content-type-text": "^2.0.2",
    "@xmtp/node-sdk": "latest",
    "concurrently": "^8.2.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "express": "^4.22.1",
    "openai": "^4.28.0",
    "viem": "^2.17.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
